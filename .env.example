# Public config baked in at build time (Cloudflare Pages env vars).
# Base URL of the ask bot API. Leave empty until ask.benkoester.com exists;
# the widget then shows its "not available yet" state.
PUBLIC_ASK_API=
# Turnstile site key (public). Empty => no challenge rendered, no token sent (local dev only).
PUBLIC_TURNSTILE_SITEKEY=
# Set to "true" for the public launch. Anything else emits <meta name="robots" content="noindex">.
PUBLIC_INDEXABLE=false
